#!/usr/bin/env bash
set -euo pipefail

#
# ─── USER CONFIG ────────────────────────────────────────────────────────────────
#
# Which target to build & flash?  (override on the command line)
#  e.g. BUILD_TARGET=pal-interface-usb ./deploy.sh
#       BUILD_TARGET=all              ./deploy.sh
BUILD_TARGET=${BUILD_TARGET:-pal-interface-bluetooth}

# All known CMake targets (must match add_executable names)
ALL_TARGETS=(
  pal-interface-bluetooth
  pal-interface-telnet
  pal-interface-usb
)

# Where your UF2s land
BUILD_DIR=build

# Where to spot the Pico mass-storage mount
TIMEOUT=100   # seconds
USER_MEDIA_PATHS=(
  "/media/$USER"
  "/run/media/$USER"
)

#
# ─── FUNCTIONS ─────────────────────────────────────────────────────────────────
#
build_firmware() {
  local target=$1

  echo "[*] Building firmware target: $target"
  mkdir -p "$BUILD_DIR"
  pushd "$BUILD_DIR" >/dev/null

    # regenerate if needed
    cmake .. 

    # build just that target
    cmake --build . --target "$target" -- -j"$(nproc)"

  popd >/dev/null
}

trigger_bootloader() {
  # bring each /dev/ttyACM* up to 1200 baud + DTR toggle
  echo "[*] Triggering Pico bootloader via serial…"
  shopt -s nullglob
  local devs=(/dev/ttyACM*)
  shopt -u nullglob

  if [ ${#devs[@]} -eq 0 ]; then
    echo "[!] No /dev/ttyACM* found. Is Pico connected?" >&2
    # exit 1
  fi

  for dev in "${devs[@]}"; do
    echo "    ↳ $dev"
    stty -F "$dev" 1200 || continue
    {
      exec 3<>"$dev"
      sleep .1
      printf "\x00" >&3 || true
      sleep .1
      exec 3>&-
    } 2>/dev/null || true
  done
}

wait_for_disconnect() {
  echo -n "[*] Waiting for Pico to disconnect…"
  for _ in {1..40}; do
    sleep .25
    shopt -s nullglob
    local now=(/dev/ttyACM*)
    shopt -u nullglob
    [ ${#now[@]} -eq 0 ] && { echo " disconnected."; return; }
    echo -n "."
  done
  echo " (timeout)"
}

copy_uf2() {
  local uf2="$BUILD_DIR/$1.uf2"
  echo "[*] Waiting for RPI-RP2 mount (timeout: $TIMEOUT s)…"
  for ((i=0;i<TIMEOUT;i++)); do
    for path in "${USER_MEDIA_PATHS[@]}"; do
      [ -d "$path" ] || continue
      local m
      m=$(find "$path" -maxdepth 1 -type d -name "RPI-RP2" 2>/dev/null | head -n1)
      if [ -n "$m" ]; then
        echo "[*] Found at: $m"
        echo "[*] Copying $uf2 → $m/"
        cp "$uf2" "$m/" && echo "[*] Upload complete." && return 0
      fi
    done
    sleep 1
    echo -n "."
  done

  echo >&2
  echo "[!] Timed out waiting for RPI-RP2 after $TIMEOUT s." >&2
  exit 1
}

#
# ─── MAIN ───────────────────────────────────────────────────────────────────────
#
if [ "$BUILD_TARGET" = "all" ]; then
  for tgt in "${ALL_TARGETS[@]}"; do
    build_firmware "$tgt"
  done
else
  build_firmware "$BUILD_TARGET"
fi

trigger_bootloader
wait_for_disconnect

# If you built “all”, you probably only want to flash one—but we’ll flash the last-built.
# Feel free to adjust this logic if you prefer to flash each in turn.
if [ "$BUILD_TARGET" = all ]; then
  copy_uf2 "${ALL_TARGETS[-1]}"
else
  copy_uf2 "$BUILD_TARGET"
fi
